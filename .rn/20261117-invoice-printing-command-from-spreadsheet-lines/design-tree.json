{
  "goal": {
    "decided": "The accounting team prints each client's invoice themselves, from the invoice lines they keep in a spreadsheet and at that client's tax rate, without writing Python.",
    "by": "user"
  },
  "deliverables": [
    {
      "name": "The accounting team and invoicer's maintainers share one account of who the invoice command serves and what it lets them do",
      "path": "docs/product-vision.md",
      "kind": "product-vision",
      "status": "done"
    },
    {
      "name": "An accountant learns from the README alone how to print an invoice from their spreadsheet at a client's tax rate, and a developer how to set the command up for them",
      "path": "README.md",
      "kind": "readme",
      "inputs": [
        "docs/product-vision.md"
      ],
      "preconditions": [],
      "status": "open",
      "necessary_conditions": [
        {
          "id": "N1",
          "good": false,
          "decisions": [
            {
              "about": "the people",
              "decided": "The opening speaks to the accountant, one on the accounting team who prints a client's invoice; a short setup section speaks to the installer, a developer who sets the command up, and the accountant's part starts at running the command.",
              "by": "user"
            },
            {
              "about": "what they achieve",
              "decided": "The accountant sends each client a correct invoice at that client's tax rate without anyone's help.",
              "by": "reasoning"
            },
            {
              "about": "the one thing",
              "decided": "invoicer's command prints the finished invoice from the invoice lines in the accountant's spreadsheet, plus the client's tax rate.",
              "by": "reasoning"
            },
            {
              "about": "the kind",
              "decided": "A command the accountant runs in a terminal, installed with the invoicer Python package.",
              "by": "research"
            }
          ]
        },
        {
          "id": "N2",
          "good": false,
          "decisions": [
            {
              "about": "remembering a rate per client",
              "decided": "A non-goal: the command remembers no client's tax rate; the accountant gives it for each invoice.",
              "by": "reasoning"
            },
            {
              "about": "the spreadsheet file the command reads",
              "decided": "A CSV file, as the accounting team already keeps its invoice lines, read with nothing extra to install.",
              "by": "user"
            },
            {
              "about": "what printing gives",
              "decided": "invoicer's existing invoice text, shown in the terminal, and saved to a file where the accountant asks for it.",
              "by": "user"
            },
            {
              "about": "the currency",
              "decided": "Always EUR; the accountant enters no currency, and only the client's tax rate changes from invoice to invoice.",
              "by": "user"
            },
            {
              "about": "Excel and Google Sheets",
              "decided": "A non-goal: the command reads no Excel or Google Sheets file, only CSV.",
              "by": "user"
            },
            {
              "about": "PDF and printers",
              "decided": "A non-goal: the command makes no PDF and sends nothing to a printer; the accountant prints the saved text file or attaches it to an email.",
              "by": "user"
            },
            {
              "about": "other currencies",
              "decided": "A non-goal: the command prints amounts in EUR only.",
              "by": "user"
            }
          ]
        },
        {
          "id": "N3",
          "good": false,
          "decisions": [
            {
              "about": "readiness",
              "decided": "Ready once the integration test of O1's use passes on the version pyproject.toml names; until then the top says what works.",
              "by": "reasoning"
            }
          ]
        },
        {
          "id": "N4",
          "good": false,
          "decisions": [
            {
              "about": "the license",
              "decided": null
            }
          ]
        },
        {
          "id": "N5",
          "good": false,
          "decisions": []
        },
        {
          "id": "N6",
          "good": false,
          "decisions": [
            {
              "about": "the walkthrough's use and task",
              "decided": "O1's use: one invoice of a few invoice lines for one client at that client's tax rate, and one unreadable invoice line refused with a message naming it.",
              "by": "reasoning"
            }
          ]
        },
        {
          "id": "N7",
          "good": false,
          "decisions": [
            {
              "about": "the one way",
              "decided": "The vision's one way, said as what the accountant sees: give the command your invoice lines as they are and the client's tax rate, and it prints the finished invoice.",
              "by": "reasoning"
            }
          ]
        },
        {
          "id": "N8",
          "good": false,
          "decisions": [
            {
              "about": "the problems and doubts",
              "decided": "Problem: printing an invoice means asking a developer. Doubts: will it read my sheet as I keep it; will the total be right; what if a line is wrong. Each is answered by one of the vision's three ideas.",
              "by": "reasoning"
            },
            {
              "about": "showing the client's tax rate on the invoice",
              "decided": null
            }
          ]
        },
        {
          "id": "N9",
          "good": false,
          "decisions": [
            {
              "about": "requirements and install",
              "decided": "Python 3.9 or later, from pyproject.toml's requires-python; the installer's commands are run and checked from a fresh start at making.",
              "by": "research"
            }
          ]
        },
        {
          "id": "N10",
          "good": false,
          "decisions": [
            {
              "about": "where to go",
              "decided": "The product vision for fuller use, and the repository's issues at github.com/lovaizu/playground for help.",
              "by": "reasoning"
            }
          ]
        }
      ]
    },
