{
  "goal": {
    "decided": "The accounting team prints each client's invoice themselves, from the invoice lines they keep in a spreadsheet and at that client's tax rate, without writing Python.",
    "by": "user"
  },
  "deliverables": [
    {
      "name": "The accounting team and invoicer's maintainers share one account of who the invoice command serves and what it lets them do",
      "path": "docs/product-vision.md",
      "kind": "product-vision",
      "inputs": [],
      "preconditions": [],
      "status": "doing",
      "necessary_conditions": [
        {
          "id": "N1",
          "good": false,
          "decisions": [
            {
              "about": "the job",
              "decided": "The product prints a client's invoice from the invoice lines the accounting team keeps in a spreadsheet, at that client's tax rate.",
              "by": "reasoning"
            },
            {
              "about": "who sets the command up for the team",
              "decided": "A developer installs Python and invoicer on the accounting team's machines; the team doesn't install anything.",
              "by": "user"
            },
            {
              "about": "the roles",
              "decided": "Two roles: the accountant, one on the accounting team who prints a client's invoice; and the installer, a developer who sets the command up on the accounting team's machines.",
              "by": "user"
            }
          ]
        },
        {
          "id": "N2",
          "good": false,
          "decisions": [
            {
              "about": "the objective",
              "decided": "O1: the accountant sends each client a correct invoice at that client's tax rate without a developer's help.",
              "by": "reasoning"
            },
            {
              "about": "the installer's objective",
              "decided": "O2: the installer gets an accountant's machine ready to print invoices without anyone's further help.",
              "by": "reasoning"
            }
          ]
        },
        {
          "id": "N3",
          "good": false,
          "decisions": []
        },
        {
          "id": "N4",
          "good": false,
          "decisions": [
            {
              "about": "the task",
              "decided": "O1: from the invoice lines in the spreadsheet and the client's tax rate to the printed invoice. O2: from a machine with nothing of invoicer on it to the accountant running the command on it.",
              "by": "reasoning"
            },
            {
              "about": "the key results",
              "decided": "O1 KR1: the share of invoices the accountant couldn't print without help or that came out with a wrong total; lower is better. O1 KR2: the time from opening the spreadsheet to the printed invoice, the accountant's own time included; lower is better. O2 KR1: the share of setups after which the command doesn't run for the accountant; lower is better. O2 KR2: the installer's time from starting a setup to the command running; lower is better. KR1 ranks before KR2 in each; no targets.",
              "by": "reasoning"
            }
          ]
        },
        {
          "id": "N5",
          "good": false,
          "decisions": [
            {
              "about": "the pieces of work and their objective",
              "decided": "The invoice command and the README's part for the accountant serve O1; the README's setup section serves O2.",
              "by": "reasoning"
            }
          ]
        },
        {
          "id": "N6",
          "good": false,
          "decisions": [
            {
              "about": "the one way",
              "decided": "The accountant gives the command the invoice lines as they already keep them in their spreadsheet, plus the client's tax rate, and gets the finished invoice back.",
              "by": "user"
            },
            {
              "about": "the ideas",
              "decided": "Their sheet as it is: the command takes the lines as the accountant already keeps them, so there's no new format to learn. Nothing wrong prints: where a line or the rate can't be read, nothing prints, and the message says which line or value to fix. The rate is given each time an invoice is printed; no rate is remembered per client.",
              "by": "user"
            },
            {
              "about": "the moments of use",
              "decided": "The setup done by the installer; the accountant gives the command the lines and the client's rate; the invoice prints, or a message says what to fix and the accountant fixes it and runs it again.",
              "by": "reasoning"
            }
          ]
        }
      ]
    },
