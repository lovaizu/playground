   "status": "open",
   "necessary_conditions": [
    {
     "id": "N1",
     "good": false,
     "decisions": [
      {
       "about": "尋ねる発行者の項目の持ち主",
       "decided": "初回に尋ねる発行者の項目、その順番、利用者に見せる日本語の言葉は、発行者情報の保管だけが決める。保存された発行者情報がないとき、発行者情報の保管は尋ねる項目の一覧を返し、コマンドはそれを受け取った順に尋ねるだけにする。コマンドの冒頭の一文は、何を尋ねるかを決めるとは言わない。",
       "by": "reasoning"
      },
      {
       "about": "請求の計算の中の分け方",
       "decided": "請求の計算の部品は、消費税と合計の決まりを持つモジュールと、締めの期間と支払期限の決まりを持つモジュールに分ける。二つは別の理由で変わるため。",
       "by": "reasoning"
      },
      {
       "about": "データの置き場の持ち主",
       "decided": "発行者情報と発行記録を置くフォルダーの場所は、一つのモジュールだけが決め、発行者情報の保管と番号の採番はそこから場所を受け取る。",
       "by": "reasoning"
      },
      {
       "about": "インストーラー",
       "decided": "インストーラーは uv であり invoice のコードではないので、モジュールにもインターフェースにもしない。S2 の流れのうち invoice のコードに届く矢印は invoice --version だけとする。",
       "by": "reasoning"
      }
     ]
    },
    {
     "id": "N2",
     "good": false,
     "decisions": [
      {
       "about": "組版が受け取る値",
       "decided": "請求書の組版が受け取る値は、invoice/templates/invoice.md.j2 と invoice/README.md の見本の請求書が載せる値をすべて含む。発行者の振込先(銀行名、支店名、口座種別、口座番号、口座名義)、各行の単位と金額、取引先の敬称(御中か様)である。組版は額を計算しない。発行者の項目には README の初回の質問にある振込先の各項目を含め、明細の読み取りは各行に README の「単位」の列を持つ。",
       "by": "reasoning"
      },
      {
       "about": "読めない・保てないときの断り",
       "decided": "発行者情報と発行記録の読み込み・保存・採番は、ファイルが読めない、壊れている、書けないときに、どのファイルの何が問題かと直し方を示して断り、コマンドはそれを日本語で利用者に示して何も印刷せずに止まる。",
       "by": "reasoning"
      }
     ]
    },
    {
     "id": "N3",
     "good": true,
     "decisions": []
    },
    {
     "id": "N4",
     "good": true,
     "decisions": []
    }
   ]
